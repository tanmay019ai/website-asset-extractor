{
  "manifest_version": 3,
  "name": "Website Asset Extractor",
  "version": "1.0.0",
  "description": "Extract and download images, SVGs, videos, audio, links, fonts, CSS, JS, and more from any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
